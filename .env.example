# Copy to .env.local for development. Use separate projects/keys for staging and production.
APP_ENV=development
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase: separate project per environment.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_publishable_anon_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Gemini: separate restricted key/budget per environment.
GEMINI_API_KEY=your_server_only_gemini_key
GEMINI_MODEL=gemini-3.5-flash

# Recruiter email OAuth and AES-256-GCM token encryption (server/worker only).
# Generate the encryption key with: openssl rand -base64 32
EMAIL_TOKEN_ENCRYPTION_KEY=replace_with_at_least_32_random_characters
GOOGLE_EMAIL_CLIENT_ID=your_google_oauth_client_id
GOOGLE_EMAIL_CLIENT_SECRET=your_google_oauth_client_secret
MICROSOFT_EMAIL_CLIENT_ID=your_microsoft_app_client_id
MICROSOFT_EMAIL_CLIENT_SECRET=your_microsoft_app_client_secret
MICROSOFT_EMAIL_TENANT_ID=common

# Billing: use test keys in development/staging and live keys only in production.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_STARTER_PRICE_ID=price_placeholder
STRIPE_PRO_PRICE_ID=price_placeholder

# Worker/BullMQ. Railway supplies PORT automatically.
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=5
PORT=8080

# Vercel-compatible centralized request limiting (server only).
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_server_only_upstash_token

# Monitoring and privacy-conscious analytics.
SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
NEXT_PUBLIC_SENTRY_DSN=https://public-key@o0.ingest.sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.01
POSTHOG_KEY=phc_placeholder
POSTHOG_HOST=https://us.i.posthog.com

# Admin and extension origins.
ADMIN_EMAILS=admin@example.com
NEXT_PUBLIC_JOBPILOT_EXTENSION_ID=your_chrome_extension_id
EXTENSION_ALLOWED_ORIGINS=chrome-extension://your_chrome_extension_id

# Feature flags and emergency switches. Production defaults must fail closed.
AI_DOCUMENTS_ENABLED=true
ASSISTED_APPLICATIONS_ENABLED=true
NEW_ATS_CONNECTORS_ENABLED=false
AUTOMATION_ENABLED=false
AUTOMATION_TEST_MODE=true
GREENHOUSE_ENABLED=true
LEVER_ENABLED=true
ASHBY_ENABLED=false
SMARTRECRUITERS_ENABLED=false
WORKABLE_ENABLED=false
